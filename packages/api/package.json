{
	"name": "@tracking-link/api",
	"private": true,
	"type": "module",
	"version": "0.1.0",
	"description": "QR redirect/logging Worker and admin API for TrackingLink.",
	"license": "MIT",
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"dev": "wrangler dev",
		"deploy": "wrangler deploy --minify",
		"typecheck": "tsc --noEmit",
		"cf-typegen": "wrangler types --env-interface CloudflareBindings",
		"db:apply:local": "wrangler d1 execute trackinglink-db --local --file=./schema.sql",
		"db:apply:remote": "wrangler d1 execute trackinglink-db --remote --file=./schema.sql",
		"test": "vitest run",
		"test:watch": "vitest",
		"loadtest:seed": "node loadtest/seed/generate.mjs --logs=100000",
		"loadtest:apply": "node loadtest/seed/run.mjs --target=local",
		"loadtest:smoke": "k6 run loadtest/k6/smoke.js",
		"loadtest:scan": "k6 run loadtest/k6/scan-sustained.js",
		"loadtest:spike": "k6 run loadtest/k6/scan-spike.js",
		"loadtest:admin": "k6 run loadtest/k6/admin-projects.js",
		"loadtest:csv": "k6 run loadtest/k6/csv-export.js",
		"loadtest:login": "k6 run loadtest/k6/login-bruteforce.js",
		"loadtest:prod:ramp": "k6 run loadtest/k6/scan-ramping-prod.js"
	},
	"dependencies": {
		"drizzle-orm": "^0.36.4",
		"hono": "^4.6.14",
		"jose": "^5.9.6",
		"zod": "^3.24.1"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20241127.0",
		"typescript": "^5.7.2",
		"vitest": "2.1.8",
		"wrangler": "^3.90.0"
	}
}
